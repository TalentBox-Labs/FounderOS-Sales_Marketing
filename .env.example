# Copy to .env and fill in your values
# CrewAI LLM Configuration
WORKCREW_CREWAI_MODEL=ollama/llama3.1:8b
WORKCREW_OLLAMA_BASE_URL=http://localhost:11434
WORKCREW_CREWAI_TEMPERATURE=0
WORKCREW_CREWAI_API_KEY=ollama

# Runtime Config Override (for staging/promotion dry-runs)
# WORKCREW_RUNTIME_CONFIG=output/.staging_runtime/W05_phase2a.json

# Google Sheets (CMS OS sheet sync)
# GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/credentials.json
# WORKCREW_GOOGLE_SHEET_ID=your-sheet-id-here

# Hashnode Blog Publishing
# HASHNODE_ACCESS_TOKEN=your-hashnode-pat
# HASHNODE_PUBLICATION_ID=your-publication-objectid
# HASHNODE_GQL_ENDPOINT=https://gql.hashnode.com/graphql  # optional

# LinkedIn Publishing (OAuth2 access token)
# LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token
# LINKEDIN_PERSON_URN=urn:li:person:XXXXXX  # optional, auto-fetched if blank

# Instagram Publishing (Facebook Graph API)
# INSTAGRAM_ACCESS_TOKEN=your-page-access-token
# INSTAGRAM_ACCOUNT_ID=your-ig-business-account-id

# YouTube Data API v3
# YOUTUBE_API_KEY=your-youtube-data-api-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# Revenue OS integrations
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# STRIPE_API_KEY=sk_...
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# N8N_API_KEY=...
# HASHNODE_TOKEN=your-hashnode-token  # legacy alias
